SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_TO=your-email@gmail.com
MAIL_FROM=your-email@gmail.com

# Supabase Database Configuration (Phase 2 - Chatbot Persistence)
# Public project URL (safe for client and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon key (safe for client and server, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Privileged service role key (SERVER-ONLY - NEVER EXPOSE WITH NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Groq AI Configuration (Phase 3 - Nexus AI Chatbot)
# Primary Model: openai/gpt-oss-120b (SERVER-ONLY - NEVER EXPOSE WITH NEXT_PUBLIC_)
GROQ_API_KEY=your-groq-api-key